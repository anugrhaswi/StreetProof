# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./data/streetproof.db
UPLOAD_DIR=./uploads
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 3 - Semantic Matching
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EMBEDDING_CACHE_DIR=./model_cache
MATCHING_THRESHOLD=0.30
MAX_CANDIDATES=10
MATCHING_WORKER_INTERVAL_SECONDS=5
MATCHING_MAX_RETRIES=3

# Phase A - Admin Authentication (set strong values before deployment)
SECRET_KEY=change-me-in-production-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# ADMIN_SESSION_EXPIRE_MINUTES=60
# ADMIN_LOGIN_RATE_LIMIT=5
# ADMIN_LOGIN_RATE_WINDOW_SECONDS=60

# Frontend (copy to frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
