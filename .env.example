# StreetProof environment configuration
# Copy backend values to backend/.env. Frontend values go to frontend/.env/.env.local.

# --------------------
# Backend (backend/.env)
# --------------------
# ENVIRONMENT=development|production|test
ENVIRONMENT=development
# DEBUG must be false in production.
DEBUG=true

# CORS_ORIGINS must be an explicit allowlist in production (JSON array or comma-separated).
# Do not use "*" when credentials/cookies are enabled.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production example (set your deployed Vercel domain; add custom domains as needed):
# ENVIRONMENT=production
# DEBUG=false
# CORS_ORIGINS=["https://your-app.vercel.app"]

# SQLite local development (default):
DATABASE_URL=sqlite:///./data/streetproof.db
# PostgreSQL/Supabase production example (set via deployment secrets; do not commit real credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional PostgreSQL pool tuning (Render/Supabase):
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_POOL_PRE_PING=true
UPLOAD_DIR=./uploads

# Phase 3 - Semantic Matching
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EMBEDDING_CACHE_DIR=./model_cache
MATCHING_THRESHOLD=0.30
MAX_CANDIDATES=10
MATCHING_WORKER_INTERVAL_SECONDS=5
MATCHING_MAX_RETRIES=3

# Phase A - Admin Authentication
# REQUIRED in production: set strong, non-default values via deployment secrets.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
ADMIN_USERNAME=replace-with-production-admin-username
ADMIN_PASSWORD=replace-with-strong-production-admin-password
# ADMIN_SESSION_EXPIRE_MINUTES=60
# ADMIN_LOGIN_RATE_LIMIT=5
# ADMIN_LOGIN_RATE_WINDOW_SECONDS=60

# --------------------
# Frontend (frontend/.env)
# --------------------
# VITE_API_BASE_URL=http://localhost:8000
# VITE_MAP_DEFAULT_LAT=26.7271
# VITE_MAP_DEFAULT_LNG=88.3953
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
